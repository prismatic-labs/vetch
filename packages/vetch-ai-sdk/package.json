{
  "name": "@prismatic-labs/vetch-ai-sdk",
  "version": "0.10.5",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "description": "First-party Vetch middleware for Vercel AI SDK 6.x - schema v2 events, local energy/carbon/cost estimates, advisories, and Edge-compatible emission.",
  "keywords": [
    "vetch",
    "ai-sdk",
    "vercel-ai-sdk",
    "ai",
    "llm",
    "middleware",
    "observability",
    "telemetry",
    "llmops",
    "finops",
    "energy",
    "carbon",
    "cost",
    "edge",
    "openai",
    "anthropic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismatic-labs/vetch.git",
    "directory": "packages/vetch-ai-sdk"
  },
  "homepage": "https://github.com/prismatic-labs/vetch/tree/main/packages/vetch-ai-sdk#readme",
  "bugs": "https://github.com/prismatic-labs/vetch/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prebuild": "node scripts/write-version.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && vitest run && node ./test/event-smoke.mjs && node ./test/event-stream-usage.mjs && node ./test/stream-middleware.mjs"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "ai": "^6.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@types/node": "^22.0.0",
    "ai": "^6.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.7"
  }
}
